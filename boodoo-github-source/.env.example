# Register a Firebase Web app in the EXISTING Boodoo project. Client config is public.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=boodoo-e5d55
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=boodoo-e5d55.firebasestorage.app
NEXT_PUBLIC_FIREBASE_APP_ID=
# Enable only after deploying the additive Firestore/Storage album rules.
NEXT_PUBLIC_WEB_ALBUMS_ENABLED=false
# Server only. Keep supplier credentials out of NEXT_PUBLIC variables.
PRODIGI_API_KEY=
PRODIGI_ENVIRONMENT=sandbox
# Choose and validate a real supplier SKU before enabling quotes.
PRODIGI_BOOK_SKU=
# The supplier quote is a production-cost estimate, not a retail checkout price.
# Comma-separated Firebase UIDs allowed to evaluate supplier production costs.
PRINT_ADMIN_UIDS=

# BOOK COMMERCE — photo books only. All switches default off.
# Keep the public buy button off until the complete test/live fulfillment is ready.
NEXT_PUBLIC_BOOK_CHECKOUT_ENABLED=false
NEXT_PUBLIC_BOOK_SHIPPING_COUNTRIES=US
# Master server-side checkout gate and independent Prodigi fulfillment gate.
STRIPE_CHECKOUT_ENABLED=false
PRINT_FULFILLMENT_ENABLED=false
BOOK_COMMERCE_LIVE_ENABLED=false
# Google Firebase service-account JSON, stored only as a protected server secret.
# The service account must access existing Firestore project; do not put JSON in Git.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Same HTTPS origin as the deployed application, without a trailing slash.
STRIPE_CHECKOUT_ORIGIN=https://www.boodoo.app
# Stripe secret key, one-time book Price ID and country-specific shipping Price IDs.
# No prices are set. Example mapping only; replace all placeholders.
STRIPE_SECRET_KEY=
STRIPE_BOOK_PRICE_ID=
STRIPE_SHIPPING_PRICE_IDS_JSON={}
# Minimum approved gross margin over (Prodigi production + Standard delivery)
# e.g. set the desired number after reviewing tax, Stripe fees and refunds.
BOOK_MIN_GROSS_MARGIN_PERCENT=
# Stripe signature secret from the registered /api/stripe/webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Only explicitly trusted PDF hosts used by administrator-approved final print files.
# Example: the privately controlled signed-URL host for print-ready assets.
PRINT_ASSET_HOSTS=
# 32+ random characters. Server signs immutable admin-reviewed print manifests.
# This is separate from Stripe and Prodigi keys, and never exposed publicly.
BOOK_MANIFEST_SIGNING_SECRET=
# Private storage bucket used for immutable user webAlbumProofs PDFs.
# Default is NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET, if unset.
PRINT_PROOF_BUCKET=
# HTTPS Prodigi order callback endpoint. Callback secret must be 24+ random chars.
PRODIGI_CALLBACK_URL=https://www.boodoo.app/api/prodigi/webhook
PRODIGI_CALLBACK_SECRET=
# Current supplier settings above (PRODIGI_API_KEY / PRODIGI_BOOK_SKU /
# PRODIGI_ENVIRONMENT) are also required. Sandbox first. Only enable production
# after supplier-specific press-ready PDF approval and successful paid-order tests.
