# Register a Firebase Web app in the EXISTING Boodoo project. Client config is public.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=boodoo-e5d55
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=boodoo-e5d55.firebasestorage.app
NEXT_PUBLIC_FIREBASE_APP_ID=
# Enable only after deploying the additive Firestore/Storage album rules.
NEXT_PUBLIC_WEB_ALBUMS_ENABLED=false
# Server only. Keep supplier credentials out of NEXT_PUBLIC variables.
PRODIGI_API_KEY=
PRODIGI_ENVIRONMENT=sandbox
# Choose and validate a real supplier SKU before enabling quotes.
PRODIGI_BOOK_SKU=
# The supplier quote is a production-cost estimate, not a retail checkout price.
# Comma-separated Firebase UIDs allowed to evaluate supplier production costs.
PRINT_ADMIN_UIDS=

# Stripe Checkout for physical BooDoo photo books (SERVER ONLY).
# Disabled until retail prices, tax/shipping, signed-off print files, fulfillment,
# verified payment webhook and idempotent order tracking are operational.
STRIPE_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_BOOK_PRICE_ID=
# HTTPS redirect URLs, e.g. https://www.boodoo.app/book/payment-success?session_id={CHECKOUT_SESSION_ID}
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
# Needed by the future verified payment webhook; no webhook is implemented yet.
STRIPE_WEBHOOK_SECRET=
